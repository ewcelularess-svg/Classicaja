# Banco Supabase: use a CONNECTION STRING do "Session pooler" (porta 5432), não a conexão direta IPv6.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@HOST_DO_POOLER:5432/postgres
DB_SSLMODE=require

# Supabase Storage (a Service Role Key fica SOMENTE no backend/Render)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=COLE_A_SECRET_KEY_sb_secret_AQUI
SUPABASE_BUCKET=product-images

# Administrador inicial de produção
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Administrador

# Produção: false. Local: pode usar true para catálogo demonstrativo.
SEED_DEMO_DATA=false
